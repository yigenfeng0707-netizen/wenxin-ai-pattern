page {
  background-color: #F5F2ED;
  color: #2C2C2C;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

view, text, image, scroll-view, swiper {
  box-sizing: border-box;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(27, 58, 92, 0.08);
  margin-bottom: 24rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1B3A5C 0%, #2C5F7C 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  display: inline-block;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFFFFF;
  color: #1B3A5C;
  border: 2rpx solid #1B3A5C;
  border-radius: 48rpx;
  padding: 24rpx 64rpx;
  font-size: 32rpx;
  text-align: center;
  display: inline-block;
}

.btn-secondary::after {
  border: none;
}

.title-lg {
  font-size: 44rpx;
  font-weight: 600;
  color: #1B3A5C;
  margin-bottom: 16rpx;
}

.title-md {
  font-size: 36rpx;
  font-weight: 500;
  color: #1B3A5C;
  margin-bottom: 12rpx;
}

.text-desc {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.8;
}

.text-amber {
  color: #D4A017;
}

.text-ochre {
  color: #A0522D;
}

.text-indigo {
  color: #1B3A5C;
}

.ai-tag {
  display: inline-block;
  background: rgba(212, 160, 23, 0.15);
  color: #D4A017;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.ai-disclaimer {
  font-size: 22rpx;
  color: #AAAAAA;
  text-align: center;
  padding: 16rpx 0;
  line-height: 1.5;
}

.loading-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2C5F7C;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) {
  animation-delay: -0.32s;
}

.loading-dots .dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}