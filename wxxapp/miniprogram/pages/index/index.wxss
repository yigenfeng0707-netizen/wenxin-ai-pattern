.hero {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.hero-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #1B3A5C;
  letter-spacing: 16rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  color: #A0522D;
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #888888;
  margin-top: 16rpx;
}

.section {
  margin-top: 40rpx;
}

.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.style-card {
  width: calc((100% - 20rpx) / 2);
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.style-card.active {
  border-color: #D4A017;
}

.style-card-inner {
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  padding: 16rpx;
}

.style-name {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.style-label {
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  padding: 12rpx 0;
  background: #FFFFFF;
}

.input-wrap {
  position: relative;
  margin-top: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  min-height: 120rpx;
  border: 2rpx solid rgba(27, 58, 92, 0.1);
}

.desc-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.8;
  color: #2C2C2C;
}

.placeholder {
  color: #CCCCCC;
}

.input-count {
  position: absolute;
  right: 28rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #AAAAAA;
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.quick-tag {
  background: rgba(27, 58, 92, 0.06);
  color: #2C5F7C;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.generate-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(to top, #F5F2ED 80%, transparent);
  z-index: 100;
}

.generate-btn {
  width: 100%;
  display: block;
}

.generate-btn[disabled] {
  opacity: 0.5;
}